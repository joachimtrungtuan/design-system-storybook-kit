{
  "name": "story-cli-kit",
  "version": "0.0.0",
  "type": "module",
  "description": "Toolkit for generating and maintaining consistent Storybook design-system projects",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "ds": "./dist/packages/cli/src/bin.js"
  },
  "exports": {
    "./preset": {
      "types": "./dist/packages/engine/src/preset/main.d.ts",
      "import": "./dist/packages/engine/src/preset/main.js"
    },
    "./preview": {
      "types": "./dist/packages/engine/src/preset/preview.d.ts",
      "import": "./dist/packages/engine/src/preset/preview.js"
    }
  },
  "imports": {
    "#engine/*": "./dist/packages/engine/src/*.js"
  },
  "files": [
    "dist",
    "templates",
    "migrations",
    "skill",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"packages/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@tailwindcss/vite": "4.3.3"
  },
  "peerDependencies": {
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/node": "24.13.3",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.1"
  }
}
