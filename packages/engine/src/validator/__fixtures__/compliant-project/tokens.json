{
  "$meta": { "iconLibrary": "synthetic" },
  "color": {
    "brand": {
      "accent": { "$base": "#769C3A", "$anchor": 500, "$mode": "hsl" }
    },
    "semantic": { "action": "{color.brand.accent.500}" }
  },
  "typography": {
    "fontFamily": { "sans": "Inter, sans-serif" },
    "fontSize": { "body": "1rem" }
  },
  "spacing": { "4": "1rem" },
  "radius": { "md": "0.5rem" },
  "shadow": { "sm": "0 1px 2px currentColor" },
  "motion": {
    "duration": { "fast": "120ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" }
  }
}
