{
  "$meta": {
    "iconLibrary": "phosphor",
    "surfaces": {
      "canvas": { "color": "{color.base.white}", "mode": "light" },
      "inverse": { "color": "{color.base.black}", "mode": "dark" }
    }
  },
  "color": {
    "brand": {
      "primary": { "$base": "#4F6B5B", "$anchor": 600, "$mode": "oklch" },
      "accent": { "$base": "#B66A3C", "$anchor": 500, "$mode": "oklch" }
    },
    "secondary": {
      "sky": { "$base": "#5B7C99", "$anchor": 500, "$mode": "oklch" }
    },
    "grey": {
      "neutral": { "$base": "#6B7280", "$anchor": 500, "$mode": "oklch" }
    },
    "base": { "white": "#FFFFFF", "black": "#111827", "transparent": "transparent" },
    "semantic": {
      "action": "{color.brand.primary.600}",
      "accent": "{color.brand.accent.500}",
      "surface": "{color.base.white}",
      "ink": "{color.grey.neutral.900}",
      "muted": "{color.grey.neutral.600}",
      "inverse": "{color.base.white}"
    }
  },
  "typography": {
    "fontFamily": { "sans": "Arial, sans-serif", "serif": "Georgia, serif" },
    "fontWeight": { "regular": 400, "medium": 500, "bold": 700 },
    "fontSize": { "body": "1rem", "small": "0.875rem", "heading": "2rem", "display": "3rem" },
    "letterSpacing": { "normal": "0em", "wide": "0.04em" },
    "lineHeight": { "body": "1.5", "heading": "1.15" }
  },
  "spacing": { "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "6": "1.5rem", "8": "2rem", "12": "3rem" },
  "radius": { "sm": "0.25rem", "md": "0.5rem", "lg": "1rem", "full": "9999px" },
  "shadow": { "sm": "0 1px 2px rgb(0 0 0 / 0.08)", "md": "0 8px 24px rgb(0 0 0 / 0.12)" },
  "motion": {
    "duration": { "fast": "120ms", "normal": "200ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" },
    "animation": { "enter": "enter var(--duration-normal) var(--ease-standard)" }
  },
  "breakpoint": { "sm": "40rem", "lg": "64rem" },
  "container": { "content": "72rem" },
  "icon": { "sm": "1rem", "md": "1.5rem", "lg": "2rem" },
  "zIndex": { "base": 0, "header": 10, "overlay": 20 }
}
